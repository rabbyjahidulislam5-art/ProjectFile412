NODE_ENV=development
PORT=4000

# Neon PostgreSQL connection string (use the pooled connection for the app)
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/smart_campus?sslmode=require

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# JWT secrets — use distinct, high-entropy values in every environment
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor
BCRYPT_SALT_ROUNDS=12

# Frontend origin the payment gateway returns users to after checkout
APP_BASE_URL=http://localhost:3000

# Wallet top-up bounds, in BDT
WALLET_MIN_TOPUP=10
WALLET_MAX_TOPUP=50000

# Payment gateway checkout endpoints
BKASH_CHECKOUT_URL=https://sandbox.bkash.com/checkout
SSLCOMMERZ_CHECKOUT_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php

# Shared secret for signing the checkout handoff and verifying the settlement
# webhook. Must match the value configured at the payment provider.
PAYMENT_GATEWAY_SECRET=replace-with-a-long-random-value
